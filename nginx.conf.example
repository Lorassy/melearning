# ─────────────────────────────────────────────────────────────
# Karne — Nginx server block (example)
# Drop into /etc/nginx/sites-available/karne.app, symlink to sites-enabled,
# reload with: nginx -t && systemctl reload nginx
# ─────────────────────────────────────────────────────────────

# ── HTTP → HTTPS + non-www redirect ───────────────────────────
server {
    listen 80;
    listen [::]:80;
    server_name karne.app www.karne.app;
    return 301 https://karne.app$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.karne.app;

    # SSL — replace with actual paths
    ssl_certificate     /etc/letsencrypt/live/karne.app/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/karne.app/privkey.pem;

    return 301 https://karne.app$request_uri;
}

# ── Main server block ─────────────────────────────────────────
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name karne.app;

    root /var/www/karne;
    index index.html;

    # SSL
    ssl_certificate     /etc/letsencrypt/live/karne.app/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/karne.app/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    # ── 301 redirects: old slugs → new ────────────────────────
    location = /use-cases/uyum-egitimleri        { return 301 /use-cases/stk-sivil-toplum; }
    location = /use-cases/uyum-egitimleri/       { return 301 /use-cases/stk-sivil-toplum; }
    location = /use-cases/uyum-egitimleri.html   { return 301 /use-cases/stk-sivil-toplum; }

    # ── Canonical: strip .html from URLs (302→301 once verified) ─
    if ($request_uri ~ ^/(.+)\.html$) {
        return 301 /$1;
    }

    # ── Extensionless serving ─────────────────────────────────
    # /features/oyunlastirma → /features/oyunlastirma.html
    location / {
        try_files $uri $uri.html $uri/ =404;
    }

    # ── Branded error pages ───────────────────────────────────
    error_page 404              /404.html;
    error_page 403              /error.html?code=403;
    error_page 500 502          /error.html?code=500;
    error_page 503 504          /error.html?code=503;

    # Serve error documents directly (don't rewrite them)
    location = /404.html   { internal; }
    location = /error.html { internal; }

    # ── Security headers ──────────────────────────────────────
    add_header X-Content-Type-Options       "nosniff"                                always;
    add_header X-Frame-Options              "SAMEORIGIN"                             always;
    add_header Referrer-Policy              "strict-origin-when-cross-origin"        always;
    add_header Permissions-Policy           "geolocation=(), microphone=(), camera=()" always;
    add_header Strict-Transport-Security    "max-age=31536000; includeSubDomains"    always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com data:; img-src 'self' data: https:; connect-src 'self' https://api.emailjs.com https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; base-uri 'self'; form-action 'self'" always;

    # ── Caching ───────────────────────────────────────────────
    location ~* \.(?:html)$ {
        expires 5m;
        add_header Cache-Control "public, must-revalidate";
    }
    location ~* \.(?:css|js)$ {
        expires 7d;
        add_header Cache-Control "public";
    }
    location ~* \.(?:png|jpg|jpeg|svg|webp|ico|gif)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
    location ~* \.(?:woff2?|ttf|otf)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header Access-Control-Allow-Origin "*";
    }

    # ── Crawler/SEO files ─────────────────────────────────────
    location = /robots.txt    { expires 1d; }
    location = /sitemap.xml   { expires 1d; }
    location = /llms.txt      { expires 1d; }

    # ── Block dotfiles ────────────────────────────────────────
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }

    # ── Gzip / Brotli ─────────────────────────────────────────
    gzip on;
    gzip_vary on;
    gzip_types text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml;
    gzip_min_length 256;
}
